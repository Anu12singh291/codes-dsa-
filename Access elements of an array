class Main {
    public static void main(String[] args) {
        // Declare and initialize array
        int[] arr = {10, 20, 30, 40, 50};

        // Access single elements
        System.out.println("First element: " + arr[0]);   // index 0 → 10
        System.out.println("Third element: " + arr[2]);   // index 2 → 30
        System.out.println("Last element: " + arr[arr.length - 1]); // 50

        // Traverse array using for loop
        System.out.print("All elements: ");
        for (int i = 0; i < arr.length; i++) {
            System.out.print(arr[i] + " ");
        }

        // Enhanced for loop (foreach)
        System.out.print("\nAll elements (foreach): ");
        for (int num : arr) {
            System.out.print(num + " ");
        }
    }
}
