import java.util.Scanner;

class RoyalPaths {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        
        int N = sc.nextInt();
        int[][] mat = new int[N][N];

        
        for (int i = 0; i < N; i++) {
            for (int j = 0; j < N; j++) {
                mat[i][j] = sc.nextInt();
            }
        }

        int mainDiagonalSum = 0;
        int secondaryDiagonalSum = 0;

        for (int i = 0; i < N; i++) {
            mainDiagonalSum += mat[i][i];             // Main diagonal
            secondaryDiagonalSum += mat[i][N - 1 - i]; // Secondary diagonal
        }

        int totalSum = mainDiagonalSum + secondaryDiagonalSum;

        
        if (N % 2 == 1) {
            totalSum -= mat[N / 2][N / 2];
        }

        System.out.println(totalSum);
    }
}
