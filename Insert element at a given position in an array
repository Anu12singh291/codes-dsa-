class InsertAtPosition {
    public static void main(String[] args) {
        int[] arr = {10, 20, 40, 50};
        int pos = 2; // position (0-based index)
        int x = 30;

        int[] newArr = new int[arr.length + 1];
        for (int i = 0; i < pos; i++) {
            newArr[i] = arr[i];
        }
        newArr[pos] = x;
        for (int i = pos; i < arr.length; i++) {
            newArr[i + 1] = arr[i];
        }

        for (int num : newArr) System.out.print(num + " ");
    }
}
