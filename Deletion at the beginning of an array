class DeleteAtBeginning {
    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 40};

        int[] newArr = new int[arr.length - 1];
        for (int i = 1; i < arr.length; i++) {
            newArr[i - 1] = arr[i];
        }

        for (int num : newArr) System.out.print(num + " ");
    }
}
