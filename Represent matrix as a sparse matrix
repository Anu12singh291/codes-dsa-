import java.util.ArrayList;
import java.util.List;

// Class to represent a non-zero element
class Element {
    int row;
    int col;
    int value;

    Element(int row, int col, int value) {
        this.row = row;
        this.col = col;
        this.value = value;
    }

    @Override
    public String toString() {
        return "(" + row + ", " + col + ") = " + value;
    }
}

public class SparseMatrix {
    public static void main(String[] args) {
        int[][] matrix = {
            {0, 0, 3},
            {4, 0, 0},
            {0, 0, 5}
        };

        // List to store non-zero elements
        List<Element> sparseMatrix = new ArrayList<>();

        // Convert normal matrix to sparse representation
        for (int i = 0; i < matrix.length; i++) {
            for (int j = 0; j < matrix[0].length; j++) {
                if (matrix[i][j] != 0) {
                    sparseMatrix.add(new Element(i, j, matrix[i][j]));
                }
            }
        }

        // Print sparse matrix
        System.out.println("Sparse Matrix Representation:");
        for (Element e : sparseMatrix) {
            System.out.println(e);
        }
    }
}
