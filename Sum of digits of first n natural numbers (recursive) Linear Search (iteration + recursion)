public class SumOfDigits {

    
    static int sumDigits(int num) {
        if (num == 0)
            return 0;
        return (num % 10) + sumDigits(num / 10);
    }


    static int sumDigitsOfFirstN(int n) {
        if (n == 0)
            return 0;
        return sumDigits(n) + sumDigitsOfFirstN(n - 1);
    }

    public static void main(String[] args) {
        int n = 12;
        System.out.println("Sum of digits from 1 to " + n + " is: " + sumDigitsOfFirstN(n));
    }
}
