class InsertAtEnd {
    public static void main(String[] args) {
        int[] arr = {10, 20, 30};
        int x = 40;

        int[] newArr = new int[arr.length + 1];
        for (int i = 0; i < arr.length; i++) {
            newArr[i] = arr[i];
        }
        newArr[arr.length] = x;

        for (int num : newArr) System.out.print(num + " ");
    }
}
