import java.util.*;

public class Fitness {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt(); // Number of test cases
        while (t-- > 0) {
            int n = sc.nextInt(); // Number of weights
            int requiredWeight = sc.nextInt(); // Required weight
            int rodWeight = sc.nextInt(); // Rod weight
            int[] weights = new int[n];
            for (int i = 0; i < n; i++) {
                weights[i] = sc.nextInt();
            }
            Arrays.sort(weights); // Sort weights in ascending order
            int totalWeight = rodWeight;
            for (int i = n - 1; i >= 0; i--) {
                if (totalWeight >= requiredWeight) break;
                totalWeight += weights[i];
            }
            if (totalWeight >= requiredWeight) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }
        sc.close();
    }
}
