class Solution {
  
    public static void rotate180(int[][] matrix) {
        int N = matrix.length;

        
        for (int i = 0; i < N; i++) {
            for (int j = 0; j < N; j++) {
                
                if (i < N / 2 || (i == N / 2 && j < N / 2)) {
                    int temp = matrix[i][j];
                    matrix[i][j] = matrix[N - 1 - i][N - 1 - j];
                    matrix[N - 1 - i][N - 1 - j] = temp;
                }
            }
        }
    }

    
    public static void printMatrix(int[][] matrix) {
        for (int[] row : matrix) {
            for (int val : row) {
                System.out.print(val + " ");
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {
        int[][] matrix = {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 9}
        };

        System.out.println("Original Matrix:");
        printMatrix(matrix);

        rotate180(matrix);

        System.out.println("Matrix after 180° Rotation:");
        printMatrix(matrix);
    }
}
