import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // Input size of array
        System.out.print("Enter size of array: ");
        int n = sc.nextInt();

        int[] arr = new int[n];

        // Input elements
        System.out.println("Enter " + n + " elements:");
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        // Multiplication of even-indexed elements
        int product = 1;   // start with 1 (multiplicative identity)
        for (int i = 0; i < n; i += 2) { // i jumps by 2
            product *= arr[i];
        }

        // Output result
        System.out.println("Product of elements at even indexes: " + product);

        sc.close();
    }
}
